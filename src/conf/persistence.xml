<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.1" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
  <persistence-unit name="Restaurant_Manager_Web_ServicePU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>com.restmanager.InsumoElaborado</class>
    <class>com.restmanager.Cliente</class>
    <class>com.restmanager.Carta</class>
    <class>com.restmanager.Mesa</class>
    <class>com.restmanager.Insumo</class>
    <class>com.restmanager.ProductovOrden</class>
    <class>com.restmanager.ProductoInsumo</class>
    <class>com.restmanager.Seccion</class>
    <class>com.restmanager.Almacen</class>
    <class>com.restmanager.Cocina</class>
    <class>com.restmanager.ProductoVenta</class>
    <class>com.restmanager.Personal</class>
    <class>com.restmanager.Area</class>
    <class>com.restmanager.Orden</class>
    <class>com.restmanager.Venta</class>
    <class>com.restmanager.DatosPersonales</class>
    <class>com.restmanager.PuestoTrabajo</class>
    <class>com.restmanager.Configuracion</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>
      <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/Restaurant_Manager_DB"/>
      <property name="javax.persistence.jdbc.user" value="Rest_Admin"/>
      <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="javax.persistence.jdbc.password" value="admin"/>
    </properties>
  </persistence-unit>
</persistence>
